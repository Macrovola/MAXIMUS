  const symbols=STOCK_SYMBOLS.map(s=>s.sym);
  for(let i=0;i<symbols.length;i+=4){
    const batch=symbols.slice(i,i+4);
    await Promise.allSettled(batch.map(async sym=>{
      try{
        const q=await fetchStockQuote(sym);
        stockCache.set(sym,{...q,ts:Date.now()});
      }catch(e){
        // Keep stale data if available, else mark as unavailable
        if(!stockCache.has(sym))stockCache.set(sym,{price:null,change:0,pct:0,dir:'flat',ts:0});
      }
    }));
    await new Promise(r=>setTimeout(r,300)); // small stagger between batches
  }
  stockLastFetch=Date.now();
  renderStockTicker();
}

function renderStockTicker(){
  const el=document.getElementById('stock-inner');
  if(!el)return;

  // Build one full set of items, then duplicate for seamless loop
  const items=STOCK_SYMBOLS.map(s=>{
    const d=stockCache.get(s.sym);
    if(!d||d.price===null){
      return`<span class="stk-item"><span class="stk-sym">${s.sym}</span><span class="stk-price" style="color:#1a3060">—</span></span><span class="stk-sep">|</span>`;
    }
    const price=d.price>=100?d.price.toFixed(2):d.price.toFixed(2);
    const chgSign=d.change>=0?'+':'';
    const arrow=d.dir==='up'?'▲':d.dir==='dn'?'▼':'—';
    return`<span class="stk-item" title="${s.name}">
      <span class="stk-sym">${s.sym}</span>
      <span class="stk-price">$${price}</span>
      <span class="stk-chg ${d.dir}">${arrow}${chgSign}${d.pct.toFixed(2)}%</span>
    </span><span class="stk-sep">|</span>`;
  }).join('');

  // Duplicate content for seamless infinite scroll
  el.innerHTML=items+items;

  // Adjust animation speed based on content width — recalc after render
  requestAnimationFrame(()=>{
    const totalW=el.scrollWidth/2; // half because we duplicated
    const speed=Math.max(40,Math.min(120,totalW/80)); // px/sec → seconds for full scroll
    el.style.animationDuration=speed+'s';
  });
}

