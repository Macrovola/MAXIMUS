    const posA=(sd.pos/total)*Math.PI*2,negA=(sd.neg/total)*Math.PI*2;
    const arcR=sz+5;
    octx.lineWidth=2.5;
    octx.strokeStyle='#22c55e';octx.beginPath();octx.arc(s.x,s.y,arcR,-Math.PI/2,-Math.PI/2+posA);octx.stroke();
    octx.strokeStyle='#ef4444';octx.beginPath();octx.arc(s.x,s.y,arcR,-Math.PI/2+posA,-Math.PI/2+posA+negA);octx.stroke();
    octx.strokeStyle='#374151';octx.beginPath();octx.arc(s.x,s.y,arcR,-Math.PI/2+posA+negA,-Math.PI/2+Math.PI*2);octx.stroke();
  }
}

