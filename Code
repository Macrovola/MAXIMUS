// MAP — TILE ENGINE
// ═══════════════════════════════════════
const TILE_SIZE=256;
const TILE_PROVIDERS=[
  (z,x,y)=>`https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/${z}/${y}/${x}`,
  (z,x,y)=>`https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/${z}/${y}/${x}`,
];
const LABEL_PROVIDERS=[
  (z,x,y)=>`https://a.basemaps.cartocdn.com/light_only_labels/${z}/${x}/${y}.png`,
  (z,x,y)=>`https://b.basemaps.cartocdn.com/light_only_labels/${z}/${x}/${y}.png`,
];
const tileCache=new Map();
const labelCache=new Map();
let tileProvider=0;
let zoom=2,panX=0,panY=0;
let isDragging=false,lastMX=0,lastMY=0;
let activeFilter='ALL';
let hoveredEvent=null,hoveredLane=null,hoveredUnit=null;

const tileC=document.getElementById('tile-canvas');
const ovC=document.getElementById('overlay-canvas');
const hitC=document.getElementById('hit-canvas');
const tctx=tileC.getContext('2d');
const octx=ovC.getContext('2d');
const mapWrap=document.getElementById('map-wrap');

function ll2world(lat,lon){const n=1<<zoom;const x=(lon+180)/360*n*TILE_SIZE;const lr=lat*Math.PI/180;const y=(1-Math.log(Math.tan(lr)+1/Math.cos(lr))/Math.PI)/2*n*TILE_SIZE;return{x,y};}
function world2ll(wx,wy){const n=1<<zoom;const lon=wx/(n*TILE_SIZE)*360-180;const yn=wy/(n*TILE_SIZE);const lat=Math.atan(Math.sinh(Math.PI*(1-2*yn)))*180/Math.PI;return{lat,lon};}
function ll2s(lat,lon){const w=ll2world(lat,lon);return{x:w.x-panX,y:w.y-panY};}
function s2ll(sx,sy){return world2ll(sx+panX,sy+panY);}

function loadTile(z,x,y,cache,providers,onload){
  const n=1<<z;x=((x%n)+n)%n;const key=`${z}/${x}/${y}`;
  if(cache.has(key))return cache.get(key);
  const e={img:null,loaded:false,failed:false};cache.set(key,e);
  const img=new Image();img.crossOrigin='anonymous';
  img.onload=()=>{e.img=img;e.loaded=true;onload&&onload();};
  img.onerror=()=>{e.failed=true;};
  img.src=providers[Math.min(tileProvider,providers.length-1)](z,x,y);
  return e;
}

function renderTiles(){
  const W=tileC.width,H=tileC.height;
  tctx.clearRect(0,0,W,H);tctx.fillStyle='#010814';tctx.fillRect(0,0,W,H);
  const n=1<<zoom;
  const minTX=Math.floor(panX/TILE_SIZE),minTY=Math.max(0,Math.floor(panY/TILE_SIZE));
  const maxTX=Math.ceil((panX+W)/TILE_SIZE),maxTY=Math.min(n-1,Math.ceil((panY+H)/TILE_SIZE));
  for(let ty=minTY;ty<=maxTY;ty++)for(let tx=minTX;tx<=maxTX;tx++){
    const ntx=((tx%n)+n)%n;const e=loadTile(zoom,ntx,ty,tileCache,TILE_PROVIDERS,()=>{renderTiles();});
    const sx=tx*TILE_SIZE-panX,sy=ty*TILE_SIZE-panY;
    if(e.loaded&&e.img)tctx.drawImage(e.img,sx,sy,TILE_SIZE,TILE_SIZE);
    else if(!e.failed){tctx.fillStyle='#0a1525';tctx.fillRect(sx,sy,TILE_SIZE-1,TILE_SIZE-1);}
  }
  for(let ty=minTY;ty<=maxTY;ty++)for(let tx=minTX;tx<=maxTX;tx++){
    const ntx=((tx%n)+n)%n;const e=loadTile(zoom,ntx,ty,labelCache,LABEL_PROVIDERS,()=>{renderTiles();});
    const sx=tx*TILE_SIZE-panX,sy=ty*TILE_SIZE-panY;
    if(e.loaded&&e.img){tctx.globalAlpha=0.85;tctx.drawImage(e.img,sx,sy,TILE_SIZE,TILE_SIZE);tctx.globalAlpha=1;}
  }
  document.getElementById('zoom-level').textContent='Z'+zoom;
}

// ═══════════════════════════════════════
// TERMINATOR — fixed to lat/lon, not screen
// ═══════════════════════════════════════
// The key fix: compute night mask in geographic space, then project to screen.
// This ensures the shadow stays geographically anchored regardless of pan/zoom.
function getSolarParams(){
  const now=new Date();
  const d2r=Math.PI/180;
  const dayOfYear=Math.floor((now-(new Date(now.getFullYear(),0,0)))/86400000);
  // Solar declination
  const decl=-23.45*Math.cos(d2r*360/365*(dayOfYear+10));
  // Sub-solar longitude (where sun is directly overhead)
  const utcHours=now.getUTCHours()+now.getUTCMinutes()/60+now.getUTCSeconds()/3600;
  const subLon=(utcHours-12)*(-15); // sun moves west
  return{decl,subLon};
}

function isNightAt(lat,lon,decl,subLon){
  const d2r=Math.PI/180;
  const sinD=Math.sin(decl*d2r);
  const cosD=Math.cos(decl*d2r);
  const dLon=(lon-subLon)*d2r;
  return sinD*Math.sin(lat*d2r)+cosD*Math.cos(lat*d2r)*Math.cos(dLon)<0;
}

// Pre-bake a night mask texture at a fixed geographic resolution
// We use a separate offscreen canvas, repainted once per second
let nightMaskCanvas=null;
let nightMaskTime=-1;
const NIGHT_RES=2; // sample every N pixels in screen space — lower = sharper but slower

function buildNightMask(W,H){
  const now=Date.now();
  if(nightMaskCanvas&&nightMaskCanvas.width===W&&nightMaskCanvas.height===H&&now-nightMaskTime<1000){
    return nightMaskCanvas;
  }
  nightMaskTime=now;
  if(!nightMaskCanvas||nightMaskCanvas.width!==W||nightMaskCanvas.height!==H){
    nightMaskCanvas=document.createElement('canvas');
    nightMaskCanvas.width=W;
    nightMaskCanvas.height=H;
  }
  const mctx=nightMaskCanvas.getContext('2d');
  const{decl,subLon}=getSolarParams();
  const imgData=mctx.createImageData(W,H);
  const data=imgData.data;
  // Sample at NIGHT_RES resolution, fill blocks
  for(let sy=0;sy<H;sy+=NIGHT_RES){
    for(let sx=0;sx<W;sx+=NIGHT_RES){
      const ll=world2ll(sx+panX,sy+panY);
      if(ll.lat<-85||ll.lat>85){continue;}
      const night=isNightAt(ll.lat,ll.lon,decl,subLon);
      if(night){
        const alpha=157; // ~62% opacity
        for(let dy=0;dy<NIGHT_RES&&sy+dy<H;dy++){
          for(let dx=0;dx<NIGHT_RES&&sx+dx<W;dx++){
            const idx=((sy+dy)*W+(sx+dx))*4;
            data[idx]=0;data[idx+1]=4;data[idx+2]=20;data[idx+3]=alpha;
          }
        }
      }
    }
  }
  mctx.putImageData(imgData,0,0);
  return nightMaskCanvas;
}

function drawTerminator(W,H){
  // Build night mask locked to current geo projection
  const mask=buildNightMask(W,H);
  octx.save();
  octx.drawImage(mask,0,0);

  // Draw terminator line by tracing lat where solar angle = 0
  const{decl,subLon}=getSolarParams();
  const d2r=Math.PI/180;
  octx.strokeStyle='rgba(255,210,100,0.5)';
  octx.lineWidth=1.5;
  octx.setLineDash([5,7]);
  octx.beginPath();
  let prev=null;
  for(let lon=-180;lon<=180;lon+=0.8){
    const tanLat=-Math.cos((lon-subLon)*d2r)/Math.tan(decl*d2r);
    const lat=Math.atan(tanLat)/d2r;
    if(Math.abs(lat)>85){prev=null;continue;}
    const s=ll2s(lat,lon);
    // Avoid wrap-around lines
    if(!prev||Math.abs(s.x-(prev.x))>W*0.3){octx.moveTo(s.x,s.y);}
    else{octx.lineTo(s.x,s.y);}
    prev=s;
  }
  octx.stroke();
  octx.setLineDash([]);
  octx.restore();
}

