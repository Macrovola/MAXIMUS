}

function toggleLayer(k){
  LAYERS[k]=!LAYERS[k];
  if(k==='flights'){LAYERS.flights?startFlightTracking():stopFlightTracking();}
  if(k==='ais'){LAYERS.ais?startAISTracking():stopAISTracking();}
  renderLayerPanel();
  markDirty();
}

function toggleLayerPanel(){
  layerPanelOpen=!layerPanelOpen;
  document.getElementById('layer-panel-body').style.display=layerPanelOpen?'block':'none';
  document.getElementById('lph-toggle').textContent=layerPanelOpen?'▼':'▶';
}

function toggleLayerCat(catId){
  catOpen[catId]=!catOpen[catId];
  renderLayerPanel();
}

function renderLayerPanel(){
  const body=document.getElementById('layer-panel-body');
  if(!body)return;
  body.innerHTML=LAYER_CATS.map(cat=>{
    const anyOn=cat.layers.some(l=>LAYERS[l.key]);
    const open=catOpen[cat.id];
    return`<div class="layer-cat">
      <div class="layer-cat-hdr${anyOn?' has-active':''}" onclick="toggleLayerCat('${cat.id}')">
        <span class="lc-icon">${cat.icon}</span>
        <span class="lc-name">${cat.name}</span>
        <span class="lc-toggle">${open?'▾':'▸'}</span>
      </div>
      ${open?`<div class="layer-items">${cat.layers.map(l=>{
        const on=LAYERS[l.key];
        const st=layerApiStatus[l.key]||'sim';
        return`<div class="layer-row" onclick="toggleLayer('${l.key}')">
          <div class="lr-switch${on?' on':''}"></div>
          <span class="lr-name${on?' on':''}">${l.name}</span>
          ${l.api?`<span class="lr-api ${st}">${st.toUpperCase()}</span>`:''}
        </div>`;
      }).join('')}</div>`:''}
    </div>`;
  }).join('');
}


