async function fetchAllFeeds(){
  setFeedStatus('loading');
  try{
    const results=await Promise.allSettled(RSS_SOURCES.map(async srcObj=>{
      const res=await fetch(`https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(srcObj.url)}&count=15`,{signal:AbortSignal.timeout(8000)});
      if(!res.ok)throw new Error('HTTP '+res.status);
      const d=await res.json();
      if(d.status!=='ok'||!d.items?.length)throw new Error('no items');
      return d.items.map(i=>{
        const h=(i.title||'').trim();const s=(i.description||'').replace(/<[^>]*>/g,'').slice(0,150).trim();
        const pub=new Date(i.pubDate||Date.now());
        const hh=pub.getUTCHours().toString().padStart(2,'0'),mm=pub.getUTCMinutes().toString().padStart(2,'0');
        const cat=classifyCat(h+' '+s);
        return{time:`${hh}:${mm}`,cat,src:srcObj.src,srcUrl:srcObj.srcUrl,hot:cat==='MIL',h,s:s||'Developing.',url:i.link||srcObj.srcUrl||'',geo:geoFromText(h+' '+s),pubDate:pub};
      }).filter(i=>i.h);
    }));
    const all=results.flatMap(r=>r.status==='fulfilled'?r.value:[]);
    const seen=new Set();
    const deduped=all.filter(i=>{const k=i.h.slice(0,40).toLowerCase().replace(/[^a-z0-9]/g,'');if(seen.has(k))return false;seen.add(k);return true;});
    if(deduped.length>0){deduped.sort((a,b)=>(b.pubDate||0)-(a.pubDate||0));NEWS=deduped.slice(0,50);liveNewsActive=true;setFeedStatus('live');}
    else throw new Error('empty');
  }catch(e){NEWS=[...NEWS_FALLBACK];liveNewsActive=false;setFeedStatus('fallback');}
  NEWS.forEach(n=>n._kwMatches=matchKW(n.h+' '+(n.s||'')));
  scanKeywords();buildNewsFeed();buildTicker();updateSentimentMini();
  if(activeLeftTab==='osint')buildLeftContent();
  DATA_SOURCES[0].status=liveNewsActive?'live':'error';
  DATA_SOURCES[1].status=liveNewsActive?'live':'error';
  document.getElementById('src-live-count').textContent=DATA_SOURCES.filter(s=>s.status==='live').length;
}
function setFeedStatus(state){
  const dot=document.querySelector('#news-header .live-dot');
  const label=document.getElementById('last-refresh');
  if(!dot||!label)return;
  const t=new Date().toUTCString().slice(17,22)+'Z';
  const c={live:'#22c55e',loading:'#eab308',fallback:'#ef4444'}[state]||'#ef4444';
  dot.style.background=c;dot.style.boxShadow=`0 0 6px ${c}`;
  label.textContent=state==='live'?'LIVE · '+t:state==='loading'?'FETCHING…':'STATIC · '+t;
}
function manualRefresh(){fetchAllFeeds();}

