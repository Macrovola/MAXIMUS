<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MAXIMUS // GEOSPATIAL INTELLIGENCE TRACKER</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{--amber:#f59e0b;--red:#ef4444;--green:#22c55e;--blue:#3b82f6;--cyan:#06b6d4;--purple:#8b5cf6;--bg:#020810;--panel:#050c18;--border:#0f2040;--text:#94a3b8;--bright:#e2e8f0;}
html,body{width:100%;height:100%;background:var(--bg);color:var(--bright);font-family:'Share Tech Mono',monospace;overflow:hidden;display:flex;flex-direction:column;}

#header{background:var(--panel);border-bottom:1px solid var(--border);padding:6px 16px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;z-index:10;gap:10px;}
.title{font-family:'Orbitron',monospace;font-size:14px;font-weight:900;color:var(--amber);letter-spacing:3px;}
.subtitle{font-size:10px;color:var(--text);letter-spacing:2px;margin-top:1px;}
.stat-pills{display:flex;gap:6px;flex-wrap:wrap;}
.pill{display:flex;flex-direction:column;align-items:center;font-size:9px;letter-spacing:1px;padding:3px 9px;border-radius:3px;border:1px solid;}
.pill span{font-size:14px;font-family:'Orbitron',monospace;font-weight:700;line-height:1;}
.pill.red{border-color:#ef444466;color:#ef4444;background:#ef444411;}
.pill.amber{border-color:#f59e0b66;color:#f59e0b;background:#f59e0b11;}
.pill.blue{border-color:#3b82f666;color:#3b82f6;background:#3b82f611;}
.pill.green{border-color:#22c55e66;color:#22c55e;background:#22c55e11;}
.pill.cyan{border-color:#06b6d466;color:#06b6d4;background:#06b6d411;}
.pill.purple{border-color:#8b5cf666;color:#8b5cf6;background:#8b5cf611;}
#utc-clock{font-family:'Orbitron',monospace;font-size:14px;font-weight:700;color:var(--green);}
#utc-date{font-size:10px;color:var(--text);letter-spacing:1px;margin-top:1px;text-align:right;}
.live-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 7px var(--green);animation:pulse 1.5s infinite;margin-right:5px;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.3;}}

#main{flex:1;display:flex;overflow:hidden;}

#left-panel{width:260px;background:var(--panel);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;}
#left-tabs{display:flex;border-bottom:1px solid var(--border);flex-shrink:0;}
.ltab{flex:1;text-align:center;padding:7px 2px;font-size:10px;letter-spacing:1px;cursor:pointer;color:var(--text);border-bottom:2px solid transparent;transition:all .15s;}
.ltab.active{color:var(--amber);border-bottom-color:var(--amber);}
.ltab:hover{color:var(--amber);}
#left-content{flex:1;overflow-y:auto;padding:8px;font-size:11px;}
#left-content::-webkit-scrollbar{width:3px;}
#left-content::-webkit-scrollbar-thumb{background:var(--border);}
.panel-title{color:var(--amber);font-size:10px;letter-spacing:2px;margin-bottom:5px;border-bottom:1px solid var(--border);padding-bottom:3px;margin-top:8px;}
.panel-title:first-child{margin-top:0;}

.event-item{padding:5px 7px;border-radius:3px;margin-bottom:4px;cursor:pointer;border:1px solid var(--border);transition:all .15s;background:#050c18;}
.event-item:hover,.event-item.active{border-color:var(--amber);background:#0f1a00;}
.event-item .etitle{font-size:11px;color:var(--bright);margin-bottom:3px;line-height:1.4;}
.event-meta{display:flex;gap:3px;flex-wrap:wrap;}
.etag{font-size:9px;padding:1px 5px;border-radius:2px;letter-spacing:1px;border:1px solid currentColor;}
.etag.mil{color:#ef4444;border-color:#ef444444;background:#ef444411;}
.etag.pol{color:#3b82f6;border-color:#3b82f644;background:#3b82f611;}
.etag.eco{color:#22c55e;border-color:#22c55e44;background:#22c55e11;}
.etag.sig{color:#8b5cf6;border-color:#8b5cf644;background:#8b5cf611;}
.etag.hum{color:#f97316;border-color:#f9731644;background:#f9731611;}
.etag.cyb{color:#06b6d4;border-color:#06b6d444;background:#06b6d411;}

.kw-item{display:flex;align-items:center;justify-content:space-between;padding:4px 6px;border-radius:3px;margin-bottom:3px;border:1px solid var(--border);background:#030a12;cursor:pointer;transition:all .15s;}
.kw-item:hover{border-color:var(--amber);}
.kw-badge{font-size:10px;padding:1px 6px;border-radius:2px;font-family:'Orbitron',monospace;font-weight:700;}
.kw-label{font-size:11px;color:var(--bright);}
.kw-add{display:flex;gap:5px;margin-bottom:8px;}
.kw-add input{flex:1;background:#030a12;border:1px solid var(--border);color:var(--bright);font-family:'Share Tech Mono',monospace;font-size:11px;padding:4px 8px;border-radius:3px;outline:none;}
.kw-add input:focus{border-color:var(--amber);}
.kw-add button{background:#1a1200;border:1px solid var(--amber);color:var(--amber);font-family:'Share Tech Mono',monospace;font-size:11px;padding:4px 10px;border-radius:3px;cursor:pointer;}

.sent-bar{display:flex;align-items:center;gap:6px;margin-bottom:5px;}
.alert-item{padding:5px 8px;border-radius:3px;margin-bottom:4px;border-left:3px solid;font-size:11px;line-height:1.5;}
.alert-item.critical{border-color:#ef4444;background:#ef444411;}
.alert-item.high{border-color:#f59e0b;background:#f59e0b0d;}
.alert-item.medium{border-color:#3b82f6;background:#3b82f60d;}
.alert-time{color:var(--text);font-size:10px;}
.alert-text{color:var(--bright);}
.alert-dismiss{float:right;cursor:pointer;color:var(--text);font-size:11px;}
.alert-dismiss:hover{color:var(--red);}
#alert-count-badge{display:inline-block;background:var(--red);color:#fff;font-size:9px;font-family:'Orbitron',monospace;padding:1px 5px;border-radius:9px;margin-left:4px;vertical-align:middle;}

.src-item{display:flex;align-items:center;gap:7px;padding:5px 7px;border-radius:3px;margin-bottom:3px;border:1px solid var(--border);background:#030a12;font-size:11px;}
.src-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.src-name{flex:1;color:var(--bright);}
.src-status{font-size:9px;padding:1px 5px;border-radius:2px;letter-spacing:1px;}
.src-live{color:#22c55e;border:1px solid #22c55e44;background:#22c55e11;}
.src-static{color:#f59e0b;border:1px solid #f59e0b44;background:#f59e0b11;}
.src-error{color:#ef4444;border:1px solid #ef444444;background:#ef444411;}

.collab-item{padding:5px 7px;border-radius:3px;margin-bottom:3px;border:1px solid var(--border);background:#030a12;font-size:11px;display:flex;align-items:center;gap:7px;}
.collab-avatar{width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;}
.collab-name{color:var(--bright);font-size:11px;}
.collab-role{color:var(--text);font-size:10px;}
.collab-status{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.collab-msg{margin-top:0;margin-bottom:6px;background:#030a12;border:1px solid var(--border);border-top:none;border-radius:0 0 3px 3px;padding:5px 7px;font-size:10px;color:var(--text);line-height:1.6;max-height:70px;overflow-y:auto;}
.legend-row{display:flex;align-items:center;gap:7px;margin-bottom:5px;font-size:11px;color:var(--text);}
.legend-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}

#map-wrap{flex:1;position:relative;overflow:hidden;background:#010814;}
#tile-canvas,#overlay-canvas,#hit-canvas{position:absolute;inset:0;width:100%;height:100%;}
#hit-canvas{opacity:0;cursor:crosshair;}
#zoom-level{position:absolute;top:8px;left:50%;transform:translateX(-50%);background:#050d1bcc;border:1px solid var(--border);border-radius:3px;padding:2px 10px;font-size:10px;color:#6b7280;letter-spacing:2px;z-index:10;}
#tooltip{position:absolute;display:none;background:#050d1bef;border:1px solid var(--amber);border-radius:4px;padding:9px 11px;max-width:270px;z-index:20;pointer-events:none;}
.tt-title{font-family:'Orbitron',monospace;font-size:10px;color:var(--amber);margin-bottom:4px;font-weight:700;}
.tt-loc{font-size:10px;color:var(--text);margin-bottom:4px;}
.tt-body{font-size:10px;color:var(--bright);line-height:1.6;white-space:pre-line;}
.tt-sent{margin-top:5px;font-size:10px;display:flex;gap:6px;flex-wrap:wrap;}
#layer-panel{position:absolute;top:10px;right:12px;z-index:10;width:210px;background:#050c18ef;border:1px solid var(--border);border-radius:5px;overflow:hidden;}
#layer-panel-header{display:flex;align-items:center;justify-content:space-between;padding:6px 10px;background:#030a12;border-bottom:1px solid var(--border);cursor:pointer;user-select:none;}
.lph-title{font-family:'Orbitron',monospace;font-size:9px;color:var(--amber);letter-spacing:2px;}
#layer-panel-body{max-height:520px;overflow-y:auto;}
#layer-panel-body::-webkit-scrollbar{width:3px;}
#layer-panel-body::-webkit-scrollbar-thumb{background:var(--border);}
.layer-cat{border-bottom:1px solid #0a1628;}
.layer-cat-hdr{display:flex;align-items:center;gap:6px;padding:5px 9px;cursor:pointer;user-select:none;background:#030a12;transition:background .15s;}
.layer-cat-hdr:hover{background:#0a1628;}
.lc-icon{font-size:11px;width:14px;text-align:center;}
.lc-name{flex:1;font-size:10px;color:var(--text);letter-spacing:1px;}
.lc-toggle{font-size:9px;color:#374151;transition:.15s;}
.layer-cat-hdr.has-active .lc-name{color:var(--amber);}
.layer-items{padding:2px 0;}
.layer-row{display:flex;align-items:center;gap:7px;padding:3px 9px 3px 22px;cursor:pointer;transition:background .15s;}
.layer-row:hover{background:#0a1628;}
.lr-switch{width:24px;height:12px;border-radius:6px;border:1px solid #1a3060;background:#030a12;position:relative;flex-shrink:0;transition:all .2s;}
.lr-switch.on{background:#22c55e22;border-color:#22c55e66;}
.lr-switch::after{content:'';position:absolute;width:8px;height:8px;border-radius:50%;background:#374151;top:1px;left:1px;transition:all .2s;}
.lr-switch.on::after{left:13px;background:var(--green);}
.lr-name{flex:1;font-size:10px;color:#4a5568;letter-spacing:1px;}
.lr-name.on{color:var(--bright);}
.lr-api{font-size:8px;padding:0 3px;border-radius:2px;letter-spacing:0;border:1px solid;}
.lr-api.live{color:#22c55e;border-color:#22c55e44;background:#22c55e11;}
.lr-api.sim{color:#f59e0b;border-color:#f59e0b44;background:#f59e0b11;}
.lr-api.err{color:#ef4444;border-color:#ef444444;background:#ef444411;}
.lr-api.fetch{color:#3b82f6;border-color:#3b82f644;background:#3b82f611;}
#zoom-btns{position:absolute;bottom:70px;right:12px;display:flex;flex-direction:column;align-items:center;gap:3px;z-index:10;}
.zoom-btn{width:30px;height:30px;background:#050c18cc;border:1px solid var(--border);border-radius:3px;color:var(--text);font-size:15px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;}
.zoom-btn:hover{border-color:var(--amber);color:var(--amber);}
#zoom-slider-wrap{width:30px;height:120px;background:#050c18cc;border:1px solid var(--border);border-radius:3px;display:flex;align-items:center;justify-content:center;position:relative;}
#zoom-slider{-webkit-appearance:none;appearance:none;width:108px;height:30px;background:transparent;cursor:pointer;outline:none;position:absolute;transform:rotate(-90deg);}
#zoom-slider::-webkit-slider-runnable-track{height:3px;background:#1a3060;border-radius:2px;}
#zoom-slider::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:3px;background:var(--amber);cursor:pointer;margin-top:-6.5px;box-shadow:0 0 6px #f59e0b88;border:1px solid #f59e0b66;}
#zoom-slider::-moz-range-track{height:3px;background:#1a3060;border-radius:2px;}
#zoom-slider::-moz-range-thumb{width:16px;height:16px;background:var(--amber);border-radius:3px;border:1px solid #f59e0b66;cursor:pointer;box-shadow:0 0 6px #f59e0b88;}
#coord-bar{position:absolute;bottom:12px;left:12px;background:#050d1bcc;border:1px solid var(--border);border-radius:4px;padding:4px 10px;font-size:10px;color:var(--text);z-index:10;letter-spacing:1px;}
#flight-bar{position:absolute;bottom:44px;left:12px;background:#050d1bcc;border:1px solid var(--border);border-radius:4px;padding:4px 10px;font-size:10px;color:var(--text);z-index:10;letter-spacing:1px;display:flex;align-items:center;gap:7px;}

#bottom-panel{height:210px;background:var(--panel);border-top:1px solid var(--border);flex-shrink:0;display:flex;flex-direction:column;overflow:hidden;}

/* STOCK TICKER */
#stock-ticker-wrap{background:#020c1a;border-top:1px solid #0a1e38;border-bottom:1px solid #0a1e38;overflow:hidden;padding:3px 0;flex-shrink:0;display:flex;align-items:center;height:22px;}
#stock-label{font-family:'Orbitron',monospace;font-size:9px;color:#f59e0b;letter-spacing:2px;padding:0 10px;flex-shrink:0;border-right:1px solid #0f2040;white-space:nowrap;}
#stock-scroll{flex:1;overflow:hidden;position:relative;}
#stock-inner{display:inline-flex;white-space:nowrap;animation:stk 80s linear infinite;}
#stock-inner:hover{animation-play-state:paused;}
@keyframes stk{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}
.stk-item{display:inline-flex;align-items:center;gap:4px;font-size:10px;padding:0 14px;font-family:'Share Tech Mono',monospace;cursor:default;}
.stk-sym{color:#e2e8f0;font-weight:bold;font-size:10px;letter-spacing:1px;}
.stk-price{color:#94a3b8;font-size:10px;}
.stk-chg.up{color:#22c55e;}
.stk-chg.dn{color:#ef4444;}
.stk-chg.flat{color:#6b7280;}
.stk-sep{color:#1a3060;font-size:10px;}
#news-header{display:flex;align-items:center;gap:8px;padding:5px 12px;border-bottom:1px solid var(--border);background:#030a12;flex-shrink:0;}
.news-label{font-family:'Orbitron',monospace;font-size:10px;color:var(--red);letter-spacing:3px;font-weight:700;}
.ns-tabs{display:flex;gap:4px;}
.ns-tab{font-size:10px;padding:2px 8px;border-radius:2px;cursor:pointer;border:1px solid var(--border);color:var(--text);letter-spacing:1px;transition:all .15s;}
.ns-tab.active{border-color:var(--amber);color:var(--amber);background:#1a2a00;}
#news-scroll-wrap{flex:1;overflow-y:scroll;}
#news-scroll-wrap::-webkit-scrollbar{width:3px;}
#news-scroll-wrap::-webkit-scrollbar-thumb{background:#1a3060;border-radius:2px;}
.news-item{display:flex;align-items:flex-start;gap:8px;padding:5px 12px;border-bottom:1px solid #0a1628;cursor:pointer;transition:background .15s;}
.news-item:hover{background:#0a1628;}
.news-item.hot{background:#0c0a00;border-left:3px solid var(--amber);}
.news-item.kw-match{border-left:3px solid var(--cyan);}
.ntime{color:var(--text);font-size:10px;min-width:50px;flex-shrink:0;padding-top:1px;}
.ncat{font-size:9px;padding:1px 4px;border-radius:2px;letter-spacing:1px;flex-shrink:0;margin-top:2px;border:1px solid currentColor;}
.ntext{color:var(--bright);font-size:11px;line-height:1.5;flex:1;}
.nhead{font-size:11px;margin-bottom:1px;font-weight:bold;}
.nsub{color:var(--text);font-size:10px;line-height:1.4;}
.nsrc{color:#4a5568;font-size:9px;flex-shrink:0;padding-top:1px;white-space:nowrap;}
.kw-tag{display:inline-block;font-size:9px;padding:0 4px;border-radius:2px;border:1px solid var(--cyan);color:var(--cyan);background:#06b6d411;margin-left:4px;}

/* Ticker — slowed down */
#ticker-wrap{background:#020810;border-top:1px solid var(--border);overflow:hidden;padding:3px 0;flex-shrink:0;}
#ticker{display:inline-block;white-space:nowrap;font-size:10px;padding-left:100%;animation:tick 320s linear infinite;}
@keyframes tick{0%{transform:translateX(0);}100%{transform:translateX(-100%);}}
.tsep{color:var(--amber);margin:0 14px;}

/* ARTICLE MODAL */
#article-modal{position:fixed;inset:0;z-index:1000;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.85);}
#article-modal.open{display:flex;}
#article-inner{background:#050c18;border:1px solid var(--amber);border-radius:6px;width:min(860px,96vw);max-height:88vh;display:flex;flex-direction:column;overflow:hidden;}
#article-header{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-shrink:0;}
#article-title-wrap{flex:1;}
#article-title{font-family:'Orbitron',monospace;font-size:13px;color:var(--amber);font-weight:700;line-height:1.4;margin-bottom:6px;}
#article-meta{font-size:10px;color:var(--text);letter-spacing:1px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
.article-badge{font-size:9px;padding:2px 7px;border-radius:2px;letter-spacing:1px;border:1px solid currentColor;}
#article-close{color:var(--text);cursor:pointer;font-size:22px;line-height:1;flex-shrink:0;padding:0 4px;transition:.15s;}
#article-close:hover{color:var(--red);}
#article-body{flex:1;overflow-y:auto;padding:20px 22px;}
#article-body::-webkit-scrollbar{width:5px;}
#article-body::-webkit-scrollbar-thumb{background:#1a3060;border-radius:2px;}
#article-content{font-size:12px;line-height:1.95;color:var(--bright);}
#article-content p{margin-bottom:14px;}
#article-content h3{color:var(--amber);font-family:'Orbitron',monospace;font-size:11px;margin:18px 0 8px;letter-spacing:2px;border-bottom:1px solid #0f2040;padding-bottom:4px;}
#article-content .source-bar{background:#030a12;border:1px solid var(--border);border-radius:4px;padding:10px 14px;margin:14px 0;font-size:11px;}
#article-content .kw-highlighted{background:#f59e0b22;color:var(--amber);padding:0 2px;border-radius:2px;}
.article-ext-link{display:inline-flex;align-items:center;gap:6px;margin-top:6px;color:var(--cyan);font-size:11px;border:1px solid #06b6d444;background:#06b6d408;padding:6px 14px;border-radius:3px;text-decoration:none;letter-spacing:1px;transition:.15s;}
.article-ext-link:hover{background:#06b6d422;border-color:var(--cyan);}
#article-footer{padding:8px 18px;border-top:1px solid var(--border);font-size:10px;color:#374151;letter-spacing:1px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;}
#article-footer .footer-src{color:#4a5568;}

#sent-mini-bar{display:flex;gap:8px;align-items:center;flex-shrink:0;}
.sm-seg{display:flex;align-items:center;gap:3px;font-size:10px;}
.sm-dot{width:7px;height:7px;border-radius:50%;}
</style>
</head>
<body>

<div id="header">
  <div><div class="title">◈ MAXIMUS // GEOSPATIAL INTELLIGENCE TRACKER</div><div class="subtitle">MULTI-SOURCE OSINT — REAL-TIME GEOSPATIAL INTELLIGENCE</div></div>
  <div class="stat-pills">
    <div class="pill red"><span>7</span>CRITICAL</div>
    <div class="pill amber"><span>12</span>HIGH</div>
    <div class="pill cyan"><span id="kw-hit-count">0</span>KW HITS</div>
    <div class="pill purple"><span id="alert-total">0</span>ALERTS</div>
    <div class="pill blue"><span id="s-act">20</span>EVENTS</div>
    <div class="pill green"><span id="src-live-count">0</span>SOURCES</div>
    <div class="pill" style="color:#f59e0b;border-color:#f59e0b44;background:#f59e0b11;cursor:pointer" title="Local proxy server status — run node server.js to enable real data" onclick="window.open('http://localhost:3001/api/status','_blank')"><span id="proxy-badge">PROXY OFF</span></div>
  </div>
  <div style="display:flex;align-items:center;gap:12px">
    <div id="sent-mini-bar">
      <div class="sm-seg"><div class="sm-dot" style="background:#22c55e"></div><span id="sm-pos" style="color:#22c55e;font-family:Orbitron,monospace;font-size:11px">—</span></div>
      <div class="sm-seg"><div class="sm-dot" style="background:#ef4444"></div><span id="sm-neg" style="color:#ef4444;font-family:Orbitron,monospace;font-size:11px">—</span></div>
      <div style="font-size:9px;color:var(--text);letter-spacing:1px">SENT</div>
    </div>
    <div style="text-align:right">
      <div><span class="live-dot"></span><span id="utc-clock">00:00:00</span> <span style="color:#4a5568;font-size:11px">UTC</span></div>
      <div id="utc-date"></div>
    </div>
  </div>
</div>

<div id="main">
  <div id="left-panel">
    <div id="left-tabs">
      <div class="ltab active" onclick="setLeftTab('events')">EVENTS</div>
      <div class="ltab" onclick="setLeftTab('osint')">OSINT<span id="alert-count-badge" style="display:none">0</span></div>
      <div class="ltab" onclick="setLeftTab('sources')">SOURCES</div>
      <div class="ltab" onclick="setLeftTab('collab')">COLLAB</div>
      <div class="ltab" onclick="setLeftTab('legend')">LEGEND</div>
    </div>
    <div id="left-content"></div>
  </div>

  <div id="map-wrap">
    <canvas id="tile-canvas"></canvas>
    <canvas id="overlay-canvas"></canvas>
    <canvas id="hit-canvas"></canvas>
