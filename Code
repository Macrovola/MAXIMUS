// Branch color coding for US bases
const BASE_COLORS={
  ARMY:'#22c55e',
  USAF:'#3b82f6',
  NAVY:'#06b6d4',
  USMC:'#f97316',
  SOCOM:'#8b5cf6',
  USSF:'#a78bfa',
};
const BASE_ICONS={ARMY:'▪',USAF:'▲',NAVY:'●',USMC:'◆',SOCOM:'★',USSF:'✦'};

let hoveredBase=null;

function drawUSBases(){
  const t=Date.now()/1000;
  const W=ovC.width,H=ovC.height;
  for(const b of US_BASES){
    const s=ll2s(b.lat,b.lon);
    if(s.x<-20||s.x>W+20||s.y<-20||s.y>H+20)continue;
    const isClosed=b.disposition.includes('CLOSED');
    const col=isClosed?'#374151':BASE_COLORS[b.service]||'#94a3b8';
    const isHov=hoveredBase&&hoveredBase.id===b.id;
    const alpha=isClosed?0.35:isHov?1.0:0.80;

    octx.save();
    octx.globalAlpha=alpha;

    // Outer glow
    if(!isClosed){
      const grd=octx.createRadialGradient(s.x,s.y,0,s.x,s.y,isHov?18:10);
      grd.addColorStop(0,col+'30');grd.addColorStop(1,col+'00');
      octx.beginPath();octx.arc(s.x,s.y,isHov?18:10,0,Math.PI*2);
      octx.fillStyle=grd;octx.fill();
    }

    // Pulse ring for active elevated/surge bases
    if(!isClosed&&(b.disposition.includes('ELEVATED')||b.disposition.includes('SURGE'))){
      const pulse=Math.sin(t*1.8+b.lat)*0.3+0.7;
      octx.globalAlpha=alpha*pulse*0.5;
      octx.strokeStyle=col;octx.lineWidth=1;
      octx.beginPath();octx.arc(s.x,s.y,isHov?16:9,0,Math.PI*2);octx.stroke();
      octx.globalAlpha=alpha;
    }

    // Base marker — pentagon shape (DoD symbol)
    const sz=isHov?7:5;
    octx.fillStyle=col+'33';
    octx.strokeStyle=col;
    octx.lineWidth=isHov?1.8:1.2;
    // Draw pentagon
    octx.beginPath();
    for(let i=0;i<5;i++){
      const angle=(i*2*Math.PI/5)-Math.PI/2;
      const x=s.x+Math.cos(angle)*sz;
      const y=s.y+Math.sin(angle)*sz;
      i===0?octx.moveTo(x,y):octx.lineTo(x,y);
    }
    octx.closePath();
    octx.fill();
    octx.stroke();

    // Service branch icon in center
    if(zoom>=4||isHov){
      octx.font=`bold ${isHov?9:7}px Share Tech Mono`;
      octx.fillStyle=col;
      octx.textAlign='center';
      octx.textBaseline='middle';
      octx.fillText(BASE_ICONS[b.service]||'●',s.x,s.y);
      octx.textBaseline='alphabetic';
    }

    // Label — show at zoom 4+ or when hovered
    if(zoom>=4||isHov){
      const lbl=b.name.split('/')[0].trim();
      const shortLbl=lbl.length>22?lbl.slice(0,20)+'…':lbl;
      octx.font=`${isHov?'bold ':''} 9px Share Tech Mono`;
      octx.textAlign='left';
      const lw=octx.measureText(shortLbl).width;
      octx.fillStyle='rgba(1,6,16,0.88)';
      octx.fillRect(s.x+sz+2,s.y-7,lw+5,11);
      octx.fillStyle=isClosed?'#4a5568':col;
      octx.fillText(shortLbl,s.x+sz+4,s.y+1);
    }

    octx.restore();
  }
  octx.textAlign='left';
  octx.textBaseline='alphabetic';
}

function baseAt(mx,my){
  let best=null,bd=Infinity;
  for(const b of US_BASES){
    const s=ll2s(b.lat,b.lon);
    const d=Math.hypot(s.x-mx,s.y-my);
    if(d<12&&d<bd){bd=d;best=b;}
  }
  return best;
}

function drawMilDisp(){
  const t=Date.now()/1000;
  for(const u of MIL_UNITS){
    const s=ll2s(u.lat,u.lon);if(s.x<-30||s.x>ovC.width+30||s.y<-30||s.y>ovC.height+30)continue;
    const col=MIL_COLORS[u.align]||'#94a3b8';const alpha={SURGE:0.95,ELEVATED:0.80,DEPLOYED:0.65}[u.status]||0.65;
    const isHov=hoveredUnit&&hoveredUnit.id===u.id;const isSurge=u.status==='SURGE';const sz=isSurge?10:u.status==='ELEVATED'?8:6;
    octx.save();octx.globalAlpha=isHov?1.0:alpha;
    if(isSurge||isHov){const pulse=Math.sin(t*2.5+u.lat)*0.35+0.65;octx.strokeStyle=col;octx.lineWidth=1.5;octx.globalAlpha=(isHov?0.9:0.4)*pulse;octx.beginPath();octx.arc(s.x,s.y,sz*2.4,0,Math.PI*2);octx.stroke();octx.globalAlpha=isHov?1.0:alpha;}
    const grd=octx.createRadialGradient(s.x,s.y,0,s.x,s.y,sz*2.5);grd.addColorStop(0,col+'33');grd.addColorStop(1,col+'00');octx.beginPath();octx.arc(s.x,s.y,sz*2.5,0,Math.PI*2);octx.fillStyle=grd;octx.fill();
    octx.fillStyle=col+'22';octx.strokeStyle=col;octx.lineWidth=isHov?2.2:1.5;
    if(u.branch==='LAND'){octx.fillRect(s.x-sz,s.y-sz,sz*2,sz*2);octx.strokeRect(s.x-sz,s.y-sz,sz*2,sz*2);}
    else if(u.branch==='NAVY'){octx.beginPath();octx.arc(s.x,s.y,sz,0,Math.PI*2);octx.fill();octx.stroke();}
    else{octx.beginPath();octx.moveTo(s.x,s.y-sz*1.2);octx.lineTo(s.x+sz,s.y+sz*0.8);octx.lineTo(s.x-sz,s.y+sz*0.8);octx.closePath();octx.fill();octx.stroke();}
    const sc={SURGE:'#ef4444',ELEVATED:'#f59e0b'}[u.status]||'#22c55e';octx.fillStyle=sc;octx.beginPath();octx.arc(s.x+sz*0.8,s.y-sz*0.8,2.5,0,Math.PI*2);octx.fill();
    if(zoom>=4||isHov){const lbl=u.name.split('—').pop().trim().slice(0,18);octx.font='10px Share Tech Mono';octx.textAlign='left';const lw=octx.measureText(lbl).width;octx.fillStyle='rgba(2,8,18,0.85)';octx.fillRect(s.x+sz+2,s.y-8,lw+5,12);octx.fillStyle=col;octx.fillText(lbl,s.x+sz+5,s.y+1);}
    octx.restore();
  }
  octx.textAlign='left';
}
function milUnitAt(mx,my){for(const u of MIL_UNITS){const s=ll2s(u.lat,u.lon);if(Math.hypot(s.x-mx,s.y-my)<14)return u;}return null;}

