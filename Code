// ── PROXY DETECTION ─────────────────────────────────────────────────────
// Auto-detects local MAXIMUS proxy server (node server.js).
// If proxy is running → real data. If not → allorigins CORS fallback.
const PROXY_URL  = 'http://localhost:3001';
const CORS_PROXY = 'https://api.allorigins.win/get?url=';
let   PROXY_ONLINE   = false;
let   PROXY_KEY_STATUS = {};

async function detectProxy(retries=5, delay=1000){
  for(let i=0;i<retries;i++){
    try{
      const r = await fetch(`${PROXY_URL}/api/status`,{signal:AbortSignal.timeout(2000)});
      if(r.ok){
        const d = await r.json();
        PROXY_ONLINE     = true;
        PROXY_KEY_STATUS = d.keys || {};
        const el=document.getElementById('proxy-badge');
        if(el){el.textContent='PROXY LIVE';el.style.color='#22c55e';el.style.borderColor='#22c55e44';el.style.background='#22c55e11';}
        console.log('[MAXIMUS] Local proxy connected — real data mode active');
        return true;
      }
    }catch(e){
      if(i<retries-1){await new Promise(r=>setTimeout(r,delay));delay=Math.min(delay*1.5,5000);}
    }
  }
  PROXY_ONLINE=false;
  const el=document.getElementById('proxy-badge');
  if(el){el.textContent='PROXY OFF';el.style.color='#f59e0b';el.style.borderColor='#f59e0b44';el.style.background='#f59e0b11';}
  console.log('[MAXIMUS] No local proxy — using CORS fallback (SIM data)');
  return false;
}

// Probe proxy every 30s so badge updates if user starts server mid-session
setInterval(detectProxy, 30000);

// Direct proxy fetch — for endpoints local server exposes
async function proxyFetch(path){
  const r=await fetch(`${PROXY_URL}${path}`,{signal:AbortSignal.timeout(8000)});
  if(!r.ok)throw new Error(`Proxy ${path} → HTTP ${r.status}`);
  return r.json();
}

// CORS fallback — when proxy is offline
function corsFetch(url){
  return fetch(CORS_PROXY+encodeURIComponent(url))
    .then(r=>r.json())
    .then(d=>{try{return JSON.parse(d.contents);}catch{return d.contents;}});
}

