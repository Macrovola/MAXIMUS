function gcPts(la1,lo1,la2,lo2,n=50){
  const r=Math.PI/180,φ1=la1*r,λ1=lo1*r,φ2=la2*r,λ2=lo2*r;
  const v1=[Math.cos(φ1)*Math.cos(λ1),Math.cos(φ1)*Math.sin(λ1),Math.sin(φ1)];
  const v2=[Math.cos(φ2)*Math.cos(λ2),Math.cos(φ2)*Math.sin(λ2),Math.sin(φ2)];
  const dot=Math.min(1,Math.max(-1,v1[0]*v2[0]+v1[1]*v2[1]+v1[2]*v2[2]));
  const omega=Math.acos(dot);if(omega<0.001)return[{lat:la1,lon:lo1},{lat:la2,lon:lo2}];
  const sinO=Math.sin(omega),pts=[];
