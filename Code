// Yahoo Finance v8 — no API key, CORS-friendly via allorigins proxy
async function fetchStockQuote(sym){
  const url=`https://query1.finance.yahoo.com/v8/finance/chart/${sym}?interval=1m&range=1d`;
  const proxy=`https://api.allorigins.win/get?url=${encodeURIComponent(url)}`;
  const res=await fetch(proxy,{signal:AbortSignal.timeout(8000)});
  if(!res.ok)throw new Error('HTTP '+res.status);
  const wrapper=await res.json();
  const data=JSON.parse(wrapper.contents);
  const meta=data?.chart?.result?.[0]?.meta;
  if(!meta)throw new Error('no meta');
  const price=meta.regularMarketPrice??meta.previousClose;
  const prev=meta.chartPreviousClose??meta.previousClose??price;
  const change=price-prev;
  const pct=(change/prev)*100;
  return{price,change,pct,dir:change>0.005?'up':change<-0.005?'dn':'flat'};
}

