  });
});

function setLayerApiStatus(key,status){
  layerApiStatus[key]=status;
  // Sync DATA_SOURCES status for SOURCES tab
  const src=DATA_SOURCES.find(s=>s.apiKey===key);
  if(src)src.status=status==='live'?'live':status==='fetch'?'static':'sim';
