async function fetchFIRMS(){
  setLayerApiStatus('firms','fetch');
  try{
    if(PROXY_ONLINE && PROXY_KEY_STATUS.firms){
      // Real FIRMS VIIRS NRT via local proxy (higher resolution, better coverage)
      const d=await proxyFetch('/api/firms?source=VIIRS_SNPP_NRT&days=1');
      if(Array.isArray(d)&&d.length){firmsData=d;setLayerApiStatus('firms','live');}
      else{firmsData=[];setLayerApiStatus('firms','sim');}
    } else {
      // CORS fallback — MODIS public CSV (no key required but may be blocked)
      const url='https://firms.modaps.eosdis.nasa.gov/data/active_fire/modis-c6.1/csv/MODIS_C6_1_Global_24h.csv';
      const txt=await corsFetch(url);
      const raw=typeof txt==='string'?txt:(txt?.contents||'');
      const lines=raw.split('\n').slice(1).filter(Boolean);
      firmsData=lines.slice(0,500).map(l=>{
