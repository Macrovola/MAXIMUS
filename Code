function drawHeatmap(){
  // Use screen blending for additive glow, then reset
  octx.globalCompositeOperation='screen';
  for(const ev of EVENTS){
    const s=ll2s(ev.lat,ev.lon);
    const w=(SEV_HEAT[ev.sev]||0.2)*0.55;
    const[r,g,b]=TYPE_HEAT_RGB[ev.type]||[200,200,200];
    const R=32+w*60;
    const a=Math.min(0.78,w*0.95);
    const grd=octx.createRadialGradient(s.x,s.y,0,s.x,s.y,R);
    grd.addColorStop(0,`rgba(${r},${g},${b},${a})`);
    grd.addColorStop(0.5,`rgba(${r},${g},${b},${a*0.4})`);
    grd.addColorStop(1,`rgba(${r},${g},${b},0)`);
    octx.beginPath();octx.arc(s.x,s.y,R,0,Math.PI*2);
    octx.fillStyle=grd;octx.fill();
  }
  octx.globalCompositeOperation='source-over';
  octx.globalAlpha=1;
}

function drawSentimentOverlay(){
  for(const ev of EVENTS){
    const sd=EVENT_SENTIMENT[ev.id];if(!sd)continue;
    const s=ll2s(ev.lat,ev.lon);const sz=SS[ev.sev]||4;
