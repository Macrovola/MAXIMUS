function aisAt(mx,my){
  let best=null,bd=Infinity;
  for(const v of aisData){
    const s=ll2s(v.lat,v.lon);
    const d=Math.hypot(s.x-mx,s.y-my);
    if(d<10&&d<bd){bd=d;best=v;}
  }
