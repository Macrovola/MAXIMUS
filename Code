// Market status badge
function isMarketOpen(){
  const now=new Date();
  const utcH=now.getUTCHours(),utcM=now.getUTCMinutes();
  const etOffset=-4; // EDT (UTC-4 during daylight saving)
  const etH=((utcH+etOffset)+24)%24;
  const etMin=etH*60+utcM;
  const day=now.getUTCDay();
  if(day===0||day===6)return false; // weekend
  return etMin>=570&&etMin<960; // 9:30 AM – 4:00 PM ET
}

function updateMarketLabel(){
  const lbl=document.getElementById('stock-label');
  if(!lbl)return;
  const open=isMarketOpen();
  const dot=open
    ?'<span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 5px #22c55e;margin-right:4px;vertical-align:middle;animation:pulse 1.5s infinite"></span>'
    :'<span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#374151;margin-right:4px;vertical-align:middle"></span>';
  lbl.innerHTML=`${dot}<span style="font-family:Orbitron,monospace;font-size:9px;color:#f59e0b;letter-spacing:2px">${open?'MARKETS LIVE':'MARKETS CLOSED'}</span>`;
}


