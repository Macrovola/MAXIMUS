function drawShippingLanes(){
  const t=Date.now()/3000;const W=ovC.width;
  for(const lane of SHIPPING_LANES){
    const pts=lane.pts.map(([la,lo])=>ll2s(la,lo));
    // Split into segments to handle anti-meridian wrap
    const segs=[];let seg=[];
    for(let i=0;i<pts.length;i++){
      if(seg.length>0&&Math.abs(pts[i].x-seg[seg.length-1].x)>W*0.35){segs.push(seg);seg=[];}
      seg.push(pts[i]);
    }
    if(seg.length)segs.push(seg);

    let col,lw,dash;
    if(lane.threat==='CRITICAL'){col='#ef4444';lw=2.5;dash=[6,4];}
    else if(lane.threat==='HIGH'&&lane.type==='ENERGY'){col='#f97316';lw=2.0;dash=[5,4];}
    else if(lane.threat==='HIGH'){col='#eab308';lw=1.8;dash=[5,4];}
    else if(lane.type==='ENERGY'){col='#f59e0b';lw=2.0;dash=[];}
    else if(lane.type==='STRATEGIC'){col='#a855f7';lw=1.5;dash=[8,5];}
    else{col='#38bdf8';lw=1.3;dash=[];}

    const isHov=hoveredLane&&hoveredLane.id===lane.id;
    if(isHov)lw*=2;

    for(const s of segs){
      if(s.length<2)continue;
      octx.save();
      octx.strokeStyle=col;
      octx.lineWidth=lw;
      octx.globalAlpha=isHov?0.95:0.65;
      octx.lineCap='round';octx.lineJoin='round';
      octx.setLineDash(dash);
      if(lane.threat==='CRITICAL'||lane.threat==='HIGH'||isHov){
        octx.shadowColor=col;octx.shadowBlur=isHov?12:6;
      }
      octx.beginPath();octx.moveTo(s[0].x,s[0].y);
      for(let i=1;i<s.length;i++)octx.lineTo(s[i].x,s[i].y);
      octx.stroke();
      octx.shadowBlur=0;
      octx.restore();
    }

    // Animated flow dot
    const allPts=segs.flat();
    if(allPts.length>3){
      const phase=((t*(lane.threat==='CRITICAL'?0.18:0.1))%1+1)%1;
      const idx=Math.floor(phase*(allPts.length-1));
      const p=allPts[Math.max(0,Math.min(allPts.length-1,idx))];
      octx.save();octx.globalAlpha=0.9;octx.shadowColor=col;octx.shadowBlur=8;
      octx.beginPath();octx.arc(p.x,p.y,3.5,0,Math.PI*2);
      octx.fillStyle=col;octx.fill();
      octx.shadowBlur=0;octx.restore();
    }

    // Chokepoint diamond
    if(lane.chokepoint&&zoom>=3){
      const mid=pts[Math.floor(pts.length*0.5)];
      if(mid&&mid.x>0&&mid.x<W&&mid.y>0&&mid.y<ovC.height){
        const dCol=lane.threat==='CRITICAL'?'#ef4444':lane.threat==='HIGH'?'#f59e0b':'#38bdf8';
        const cs=5;
        octx.save();octx.globalAlpha=0.9;octx.shadowColor=dCol;octx.shadowBlur=7;
        octx.fillStyle=dCol;
        octx.beginPath();octx.moveTo(mid.x,mid.y-cs);octx.lineTo(mid.x+cs,mid.y);octx.lineTo(mid.x,mid.y+cs);octx.lineTo(mid.x-cs,mid.y);octx.closePath();octx.fill();
        octx.shadowBlur=0;octx.restore();
      }
    }
  }
}

function shippingAt(mx,my){
  for(const lane of SHIPPING_LANES){
    for(let i=0;i<lane.pts.length-1;i++){
      const a=ll2s(lane.pts[i][0],lane.pts[i][1]),b=ll2s(lane.pts[i+1][0],lane.pts[i+1][1]);
      if(Math.abs(b.x-a.x)>ovC.width*0.35)continue;
      const dx=b.x-a.x,dy=b.y-a.y,lsq=dx*dx+dy*dy;
      if(lsq<1)continue;
      const t_=Math.max(0,Math.min(1,((mx-a.x)*dx+(my-a.y)*dy)/lsq));
      if(Math.hypot(mx-a.x-t_*dx,my-a.y-t_*dy)<10)return lane;
    }
  }
  return null;
}

