function loop(ts){
  if(ts-_lastScroll>90){scrollNews();_lastScroll=ts;}
  updateClock();
  // Only redraw when dirty OR moving aircraft (every 40ms max)
  const hasAnimated=LAYERS.flights&&aircraft.size>0;
  const hasPulse=LAYERS.bases||LAYERS.mil||LAYERS.acled||LAYERS.firms;
  const needsAnim=hasAnimated||hasPulse;
  if(_dirty||(needsAnim&&ts-_lastDraw>DRAW_INTERVAL)){
    drawOverlay();
    _lastDraw=ts;
    _dirty=false;
  }
  requestAnimationFrame(loop);
}

